{
  "ConnectionStrings": {
    "Default": "Data Source=data/pricechecker.db"
  },
  "Monitoring": {
    "Enabled": true,
    "Interval": "00:10:00",
    "StartupDelay": "00:00:10"
  },
  "Email": {
    "Provider": "log",
    "FromAddress": "noreply@pricechecker.local",
    "FromName": "Prinzip Price Checker",
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "UseStartTls": false,
      "UserName": "",
      "Password": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
